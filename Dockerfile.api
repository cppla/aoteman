FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AOTEMAN_DATA_DIR=/data \
    BACKUP_INTERVAL_SECONDS=900

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 aoteman \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app aoteman \
    && mkdir -p /data/backups \
    && chown -R 10001:10001 /data

COPY server/ ./server/
# This tracked database is an empty, versioned template, never a player's save.
COPY --chown=10001:10001 database/ ./database/

USER 10001:10001
EXPOSE 8081

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/api/healthz', timeout=3).read()" || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:8081", "--workers", "1", "--threads", "4", "--timeout", "30", "--worker-tmp-dir", "/tmp", "--access-logfile", "-", "--error-logfile", "-", "server.app:application"]
